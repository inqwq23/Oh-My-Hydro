{
  "name": "hutoj-username-change",
  "version": "1.3.0",
  "description": "Hydro plugin that allows users to change their username once every 30 days.",
  "main": "index.ts",
  "files": [
    "index.ts",
    "policy.ts",
    "frontend",
    "templates",
    "README.md"
  ],
  "license": "MIT",
  "preferUnplugged": true,
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/policy.test.ts",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:template": "node scripts/check-template.mjs",
    "verify": "npm test && npm run typecheck && npm run check:bundle && npm run check:template"
  },
  "devDependencies": {
    "esbuild": "0.25.2",
    "hydrooj": "5.0.4",
    "nunjucks": "3.2.4",
    "typescript": "6.0.3"
  }
}
