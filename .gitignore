# Dependencies and package manager state
node_modules/
node_modules.*
.yarn/cache/
.yarn/build-state.yml
.yarn/unplugged/
.yarn/sdks/
.yarn/install-state.gz
.pnp.*

# Build output, caches, and logs
.build/
dist/
*.cache
.cache
/build/*.js
*.log
*.js.map
*.tsbuildinfo
*.hydro

# Test and profiling output
.coverage
coverage
.nyc_output
benchmark.json
globalConfig.json
*.out
.clinic/

# Local environment and tooling
.direnv/
.omc/
.monokle
*.local
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local and generated workspace configuration
/config.yaml
/config.json
yarn.lock
pnpm-lock.yaml
tsconfig.json
tsconfig.*.json
.oxlintrc.json

# Core generated JavaScript (preserve authored scripts)
packages/**/*.js
!/build/*.js
!**/bin/*.js
!*.page.js
!packages/register/index.js
!packages/ui-default/**/*.js
!packages/geoip/download.js
!examples/**

# Generated UI assets
packages/ui-default/public
packages/ui-default/misc/.iconfont
packages/ui-default/static/locale
packages/ui-next/public
packages/*/public/assets

# Locally installed plugins and modules
/plugins/
/modules/

# User addon source configuration and lockfiles
!/usraddons/**/tsconfig.json
!/usraddons/**/tsconfig.*.json
!/usraddons/**/yarn.lock
!/usraddons/**/pnpm-lock.yaml

# Data files
*.mmdb

# Temporary files (preserve fixtures and directory placeholders)
__*
!__mocks__
!.gitkeep

# OS metadata
.DS_Store
Thumbs.db
*:Zone.Identifier
